# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://agentnet:agentnet_dev@localhost:5432/agentnet

# JWT (stub identity provider)
JWT_SECRET=replace-with-a-secure-secret-in-production
JWT_ISSUER=agentnet
JWT_AUDIENCE=agentnet-api
JWT_TTL_MINUTES=15

# Audit backend: postgres (default) or blockchain
# AUDIT_BACKEND=postgres

# Blockchain (required when AUDIT_BACKEND=blockchain)
# BLOCKCHAIN_PEER_ENDPOINT=localhost:7051
# BLOCKCHAIN_PEER_HOST_ALIAS=peer0.org1.example.com
# BLOCKCHAIN_TLS_CERT_PATH=./crypto/peers/peer0.org1.example.com/tls/ca.crt
# BLOCKCHAIN_CERT_PATH=./crypto/users/User1@org1.example.com/msp/signcerts/cert.pem
# BLOCKCHAIN_KEY_PATH=./crypto/users/User1@org1.example.com/msp/keystore/priv_sk
# BLOCKCHAIN_MSP_ID=Org1MSP
# BLOCKCHAIN_CHANNEL=audit-channel
# BLOCKCHAIN_CHAINCODE=auditlog

# Okta (for future real integration)
# OKTA_DOMAIN=https://your-org.okta.com
# OKTA_CLIENT_ID=
# OKTA_CLIENT_SECRET=
